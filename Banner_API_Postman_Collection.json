{
	"info": {
		"_postman_id": "banner-api-collection",
		"name": "Customer Banner APIs",
		"description": "APIs for fetching and tracking banners in the customer app",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Active Banners",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/banners",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"banners"
					]
				},
				"description": "Get all active banners without any position filter"
			},
			"response": []
		},
		{
			"name": "Get Home Top Banners",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/banners?position=home_top",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"banners"
					],
					"query": [
						{
							"key": "position",
							"value": "home_top",
							"description": "Filter by banner position"
						}
					]
				},
				"description": "Get banners for home top position"
			},
			"response": []
		},
