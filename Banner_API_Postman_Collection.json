		{
			"name": "Track Banner Click",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/banners/{{banner_id}}/click",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"banners",
						"{{banner_id}}",
						"click"
					]
				},
				"description": "Track when a customer clicks on a banner. Replace {{banner_id}} with actual banner ID."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1/customer",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "your_jwt_token_here",
			"type": "string"
		},
		{
			"key": "banner_id",
			"value": "banner-uuid-here",
			"type": "string"
		}
	]
